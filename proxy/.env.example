# Chave da API da Anthropic (console.anthropic.com) — NUNCA vai para o navegador
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# String secreta que o app deve enviar no header x-proxy-key.
# Gere algo aleatório, ex.: openssl rand -hex 24
PROXY_SHARED_SECRET=troque-por-uma-string-aleatoria-longa

# Origens autorizadas a chamar este proxy, separadas por vírgula.
# Ex.: https://davileles.github.io,https://financas.seudominio.com.br
ALLOWED_ORIGINS=

# Porta local (o Railway define PORT automaticamente em produção)
PORT=3000
